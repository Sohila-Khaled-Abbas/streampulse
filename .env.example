# ==============================================================================
# StreamPulse Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file to version control.

# --- APIs Configuration ---
# RapidAPI Key for Netflix UnoGS / Catalog API
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=unogsng.p.rapidapi.com

# The Movie Database (TMDb) API Credentials
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_bearer_token_here

# --- Database Configuration (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=streampulse
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SCHEMA_STAGING=staging
DB_SCHEMA_REPORTING=reporting

# --- Airbyte Configuration ---
AIRBYTE_HOST=localhost
AIRBYTE_PORT=8000
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password

# --- Application & Pipeline Settings ---
APP_ENV=development
LOG_LEVEL=INFO
BATCH_SIZE=100
FUZZY_MATCH_THRESHOLD=85
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
