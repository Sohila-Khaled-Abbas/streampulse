	measure Bayesian_Quality_Badge =
			
			VAR _Score = [Bayesian_Weighted_Score]
			RETURN IF(NOT ISBLANK(_Score), "★ " & FORMAT(_Score, "0.0") & " / 10", BLANK())
		displayFolder: 04: Bayesian Rating & Quality Scoring
		lineageTag: 38c39133-5cb9-4fb8-986e-91dcfeb56074

