	measure Avg_Completion_Rate_Pct = AVERAGE(Fact_Streaming_Performance[avg_completion_pct])
		displayFolder: 01: Core Streaming & Catalog KPIs
		lineageTag: fce14974-270e-48d6-afa7-9722e6bc3541

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Subscribers_Reached_K = SUM(Fact_Streaming_Performance[subscribers_reached_thousands])
		formatString: 0
		displayFolder: 01: Core Streaming & Catalog KPIs
		lineageTag: 2bc3f0d7-ecc8-413c-9409-a03111c2d5f5

	measure Avg_Runtime_Minutes = AVERAGE(Dim_Titles[runtime_minutes_clean])
		displayFolder: 01: Core Streaming & Catalog KPIs
		lineageTag: 933ed17e-296c-42c1-b3c8-243690167a13

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure View_Hours_YTD = CALCULATE([Total_View_Hours_M], DATESYTD(Dim_Date[full_date]))
		displayFolder: 02: Time Intelligence
		lineageTag: 2956c4a7-cdb3-4fbc-934e-44950457e06a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure View_Hours_PY = CALCULATE([Total_View_Hours_M], SAMEPERIODLASTYEAR(Dim_Date[full_date]))
		displayFolder: 02: Time Intelligence
		lineageTag: f9c89177-8323-40a3-93b0-f20d2ea4657b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure View_Hours_YoY_Growth =
			VAR _Current = [Total_View_Hours_M]
			VAR _Prior = [View_Hours_PY]
			RETURN IF(NOT ISBLANK(_Prior), _Current - _Prior, BLANK())
		displayFolder: 02: Time Intelligence
		lineageTag: 2a262113-2ea9-49f3-97b6-e3b279409ddd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure View_Hours_YoY_Pct = DIVIDE([View_Hours_YoY_Growth], [View_Hours_PY], BLANK())
		displayFolder: 02: Time Intelligence
		lineageTag: b8431d1c-216c-4df1-a9bd-c2c129af56e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure View_Hours_PM = CALCULATE([Total_View_Hours_M], PREVIOUSMONTH(Dim_Date[full_date]))
		displayFolder: 02: Time Intelligence
		lineageTag: 9ac05c0d-ab63-4a94-a3fa-04458de26e3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure View_Hours_MoM_Pct = DIVIDE([Total_View_Hours_M] - [View_Hours_PM], [View_Hours_PM], BLANK())
		displayFolder: 02: Time Intelligence
		lineageTag: 0f2552ea-253a-40fe-8b45-b7d3e5888b4e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rolling_28D_View_Hours = CALCULATE([Total_View_Hours_M], DATESINPERIOD(Dim_Date[full_date], MAX(Dim_Date[full_date]), -28, DAY))
		displayFolder: 02: Time Intelligence
		lineageTag: fb1ac521-d138-4fef-9209-f404c309f89b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rolling_90D_View_Hours = CALCULATE([Total_View_Hours_M], DATESINPERIOD(Dim_Date[full_date], MAX(Dim_Date[full_date]), -90, DAY))
		displayFolder: 02: Time Intelligence
		lineageTag: da0ece5a-ae11-43d4-a8ca-b4c331463b00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Pareto_Cumulative_View_Hours =
			VAR _CurrentHours = [Total_View_Hours_M]
			VAR _AllTitles = ALLSELECTED(Dim_Titles[title_key], Dim_Titles[title])
			RETURN
			    IF(
			        NOT ISBLANK(_CurrentHours),
			        SUMX(FILTER(_AllTitles, [Total_View_Hours_M] >= _CurrentHours), [Total_View_Hours_M])
			    )
		displayFolder: 03: Advanced Analytics & Pareto 80/20 Concentration
		lineageTag: 0daa4f8a-0168-4e07-b0aa-7b5422e45311

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Pareto_Cumulative_Pct = DIVIDE([Pareto_Cumulative_View_Hours], CALCULATE([Total_View_Hours_M], ALLSELECTED(Dim_Titles)), BLANK())
		displayFolder: 03: Advanced Analytics & Pareto 80/20 Concentration
		lineageTag: f4d62ed1-2389-48e9-9dcc-90dd5c79c633

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Pareto_Catalog_Tier =
			VAR _CumPct = [Pareto_Cumulative_Pct]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_CumPct), BLANK(),
			        _CumPct <= 0.80, "Tier A (Top 80% Engine)",
			        _CumPct <= 0.95, "Tier B (Mid 15% Sustainer)",
			        "Tier C (Long-Tail 5%)"
			    )
		displayFolder: 03: Advanced Analytics & Pareto 80/20 Concentration
		lineageTag: 92864bfc-6925-448e-9852-7fbe672ec2f6

	measure Top_10_Concentration_Share_Pct =
			VAR _Top10Hours = CALCULATE([Total_View_Hours_M], TOPN(10, ALLSELECTED(Dim_Titles), [Total_View_Hours_M], DESC))
			VAR _TotalHours = CALCULATE([Total_View_Hours_M], ALLSELECTED(Dim_Titles))
			RETURN DIVIDE(_Top10Hours, _TotalHours, BLANK())
		displayFolder: 03: Advanced Analytics & Pareto 80/20 Concentration
		lineageTag: fc815ab0-64d0-4b69-b14a-ab2c7896b335

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_IMDb_Rating = AVERAGE(Fact_Catalog_Ratings[vote_average])
		displayFolder: 04: Bayesian Rating & Quality Scoring
		lineageTag: c02c55e7-95f1-48c9-add3-6cddae2d4372

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Vote_Count = SUM(Fact_Catalog_Ratings[vote_count])
		formatString: 0
		displayFolder: 04: Bayesian Rating & Quality Scoring
		lineageTag: 8200a76c-f793-4cc9-9c99-2b675ffb9865

	measure Bayesian_Weighted_Score =
			VAR _R = [Avg_IMDb_Rating]
			VAR _v = [Total_Vote_Count]
			VAR _m = 25000.0
			VAR _C = 7.0
			RETURN
			    IF(NOT ISBLANK(_R) && _v > 0, DIVIDE(_v * _R + _m * _C, _v + _m, BLANK()), _C)
		displayFolder: 04: Bayesian Rating & Quality Scoring
		lineageTag: 2607084b-7f0d-4986-ba7c-2dad7d044c52

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_Critic_Score = AVERAGE(Fact_Catalog_Ratings[critic_score])
		formatString: 0
		displayFolder: 04: Bayesian Rating & Quality Scoring
		lineageTag: 001f5116-2eb1-4b5e-bd97-b86d48a09c37

	measure Critic_Audience_Gap =
			VAR _AudienceScaled = [Avg_IMDb_Rating] * 10.0
			VAR _Critic = [Avg_Critic_Score]
			RETURN IF(NOT ISBLANK(_Critic) && NOT ISBLANK(_AudienceScaled), _AudienceScaled - _Critic, BLANK())
		displayFolder: 04: Bayesian Rating & Quality Scoring
		lineageTag: 560bbb49-d8ae-4ec5-bae5-d87c0f3e41ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Quality_Tier_Classification =
			VAR _Score = [Bayesian_Weighted_Score]
			RETURN
			    SWITCH(
			        TRUE(),
			        _Score >= 8.3, "🏆 Masterpiece (Top Tier)",
			        _Score >= 7.5, "⭐ Certified Hit",
			        _Score >= 6.5, "👍 Solid Performer",
			        "⚠️ Mixed / Polarizing"
			    )
		displayFolder: 04: Bayesian Rating & Quality Scoring
		lineageTag: 36b16d35-f9b3-46d4-a124-8ba835b2dded

	measure Total_Production_Budget_M = DIVIDE(SUM(Fact_Financial_ROI[production_budget_usd]), 1000000, BLANK())
		displayFolder: 05: Financial ROI & Unit Economics
		lineageTag: 41978163-9ec1-4d87-a7e3-deccf0801374

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Worldwide_Gross_M = DIVIDE(SUM(Fact_Financial_ROI[worldwide_gross_usd]), 1000000, BLANK())
		displayFolder: 05: Financial ROI & Unit Economics
		lineageTag: f9c0e37f-5d2d-4162-b440-44c0db35d1ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Net_Box_Office_Profit_M =
			VAR _Gross = [Total_Worldwide_Gross_M]
			VAR _Budget = [Total_Production_Budget_M]
			RETURN IF(NOT ISBLANK(_Gross) && _Gross > 0, _Gross - _Budget, BLANK())
		displayFolder: 05: Financial ROI & Unit Economics
		lineageTag: 4014f19f-c31e-4caf-b431-c332ee30d2ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Financial_ROI_Multiplier = DIVIDE([Total_Worldwide_Gross_M], [Total_Production_Budget_M], BLANK())
		displayFolder: 05: Financial ROI & Unit Economics
		lineageTag: 13b7097f-e930-4cf9-ada1-b11184180484

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cost_Per_View_Hour_USD =
			VAR _TotalBudgetUSD = SUM(Fact_Financial_ROI[production_budget_usd])
			VAR _TotalViewHours = [Total_View_Hours_M] * 1000000
			RETURN DIVIDE(_TotalBudgetUSD, _TotalViewHours, BLANK())
		displayFolder: 05: Financial ROI & Unit Economics
		lineageTag: 5b4c8ba5-6d80-423e-ac3c-9718c6eb5bf5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Budget_Efficiency_Index = DIVIDE([Total_View_Hours_M], [Total_Production_Budget_M], BLANK())
		displayFolder: 05: Financial ROI & Unit Economics
		lineageTag: b8b537c2-d45c-493e-83ee-92dd7821eb75

		annotation PBI_FormatHint = {"isGeneralNumber":true}

